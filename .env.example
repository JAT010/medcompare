# Local development example only. Do not commit real credentials.
MEDCOMPARE_DATABASE_URL=postgresql+psycopg://medcompare:medcompare_dev_only@localhost:5433/medcompare
TEST_DATABASE_URL=postgresql+psycopg://medcompare:medcompare_dev_only@localhost:5433/medcompare_test
POSTGRES_DB=medcompare
POSTGRES_USER=medcompare
POSTGRES_PASSWORD=medcompare_dev_only
POSTGRES_PORT=5433
MEDCOMPARE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:3000"]
MEDCOMPARE_DEBUG=true

# Operator token required for ALL sensitive hospital integration operations
# (creating/enabling/configuring a source, running captures, controlling
# verification jobs, resolving reconciliation cases, managing monitoring).
# When unset, those endpoints are closed with 503 operator_api_key_not_configured.
# Use a long random value; never commit a real one.
MEDCOMPARE_OPERATOR_API_KEY=

# Reference for the documented simulated/mock connector flows used in tests
# and demos (never a real hospital credential).
# MEDCOMPARE_HOSPITAL_API_EXAMPLE_TOKEN=

# Live authorized hospital REST API is configured per-integration through the
# API (allowlisted base_url in config_json, credential_env_ref pointing at an
# env var here). Example shape only; performs no connections by default.
# MEDCOMPARE_HOSPITAL_API_NORTHBRIDGE_TOKEN=
